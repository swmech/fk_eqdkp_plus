<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # --- Block Bad User-Agents ---
    RewriteCond %{HTTP_USER_AGENT} (Claude-SearchBot|ClaudeBot|GPTBot|ChatGPT-User|AhrefsBot|SemrushBot) [NC,OR]
    
    # --- Block Alibaba IP Ranges (checks both direct IP and Railway Proxy Header) ---
    RewriteCond %{HTTP:X-Forwarded-For} ^47\.(79|82)\. [OR]
    RewriteCond %{REMOTE_ADDR} ^47\.(79|82)\. [OR]

    # --- Block Scraper IP Ranges (China Unicom 116.179.x.x & US 66.118.56.x) ---
    RewriteCond %{HTTP:X-Forwarded-For} ^116\.179\. [OR]
    RewriteCond %{REMOTE_ADDR} ^116\.179\. [OR]
    RewriteCond %{HTTP:X-Forwarded-For} ^66\.118\.(5[6-9]|6[0-3])\. [OR]
    RewriteCond %{REMOTE_ADDR} ^66\.118\.(5[6-9]|6[0-3])\.

    RewriteRule .* - [F,L]

    # Stop processing if it's a real file or directory
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f

    # Send everything else to index.php
    RewriteRule ^(.*)$ index.php?$1 [L,QSA]
</IfModule>

Options -Indexes
