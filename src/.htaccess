<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # --- Block Known AI Bots & Scraping Networks ---
    RewriteCond %{HTTP_USER_AGENT} (Claude-SearchBot|ClaudeBot|GPTBot|ChatGPT-User|AhrefsBot|SemrushBot) [NC,OR]
    
    # Block major Alibaba Cloud IP prefixes (47.x.x.x, 8.208-223.x.x, 149.129.x.x, 161.117.x.x, 170.33.x.x)
    RewriteCond %{REMOTE_ADDR} ^(47\.|8\.2[0-2][0-9]\.|149\.129\.|161\.117\.|170\.33\.)
    RewriteRule .* - [F,L]

    # Existing rewrite conditions
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ index.php?$1 [L,QSA]
</IfModule>

Options -Indexes

